# Heavy result directories are symlinked to the main checkout — never track them.
# (no trailing slash: these are symlinks, not real dirs, on this machine)
results
study1-nongaussian
study1-nongaussian-cl2
study2-grid-refinement
study2-results-extracted
study2-cl2-timing
cl2-pilot
logs

# Rendered artifacts (regenerated by quarto)
*.html
*.pdf
*.tex
*_files/
.Rhistory

# but keep the application/figure assets we explicitly want
!article-visualization.pdf

# ...and DO track the Quarto journal-extension LaTeX templates/partials.
# The broad *.tex rule above would otherwise drop them (e.g.
# _extensions/.../partials/title.tex), which breaks rendering in fresh checkouts.
!_extensions/**/*.tex

# LaTeX render byproducts (top-level only; do not touch _extensions assets)
*.aux
*.bbl
*.blg
*.log
/jsslogo.jpg
